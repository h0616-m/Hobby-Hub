{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://<your-render-backend-name>.onrender.com/api/:path*"
    },
    {
      "source": "/oauth2/:path*",
      "destination": "https://<your-render-backend-name>.onrender.com/oauth2/:path*"
    },
    {
      "source": "/login/oauth2/:path*",
      "destination": "https://<your-render-backend-name>.onrender.com/login/oauth2/:path*"
    }
  ]
}
